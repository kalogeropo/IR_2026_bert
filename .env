# Machine-specific settings of the IR lab, read by irlab/config.py when irlab is imported.
# A variable already set in the shell takes precedence over this file.
# Relative paths are relative to the project folder; ~ is expanded.

# Where models run: auto (GPU if PyTorch sees one, else CPU), cpu, or cuda (error if no GPU).
IRLAB_DEVICE=auto

# Downloaded collections, the embedding cache, and the CSV/JSON outputs.
IRLAB_DATA_DIR=data
IRLAB_CACHE_DIR=cache
IRLAB_RESULTS_DIR=results
